.page {
  padding: 24rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: bold;
  margin: 20rpx 8rpx;
}

.block-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  border: 2rpx solid #e5e7eb;
}

.block-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f6feb;
}

.block-summary {
  font-size: 28rpx;
  margin-top: 10rpx;
}

.block-excerpt {
  font-size: 26rpx;
  color: #666666;
  margin-top: 10rpx;
  background: #f5f6fa;
  border-radius: 8rpx;
  padding: 16rpx;
}

.block-scope {
  font-size: 24rpx;
  color: #999999;
  margin-top: 10rpx;
}
.start-btn {
  background: #1f6feb;
  color: #ffffff;
  border-radius: 14rpx;
  font-size: 32rpx;
  margin-top: 24rpx;
}