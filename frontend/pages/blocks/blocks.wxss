.page {
  padding: 24rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: bold;
  margin: 20rpx 8rpx;
}

.block-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  border: 2rpx solid #e5e7eb;
}

.block-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f6feb;
}

.block-summary {
  font-size: 28rpx;
  margin-top: 10rpx;
}

.block-excerpt {
  font-size: 26rpx;
  color: #666666;
  margin-top: 10rpx;
  background: #f5f6fa;
  border-radius: 8rpx;
  padding: 16rpx;
}

.block-scope {
  font-size: 24rpx;
  color: #999999;
  margin-top: 10rpx;
}
.start-btn {
  background: #1f6feb;
  color: #ffffff;
  border-radius: 14rpx;
  font-size: 32rpx;
  margin-top: 24rpx;
}
/* ===== PC 宽屏适配：按钮不换行 + 压缩纵向尺寸 ===== */
@media (min-width: 800px) {
  .page { padding: 16px; }
  .section-title { font-size: 18px; margin: 10px 4px; }
  .block-card { padding: 12px; margin-bottom: 10px; }
  .block-name { font-size: 17px; }
  .block-summary { font-size: 15px; margin-top: 6px; }
  .block-excerpt { font-size: 14px; margin-top: 6px; padding: 8px; }
  .block-scope { font-size: 13px; margin-top: 6px; }
  .start-btn {
    font-size: 16px;
    padding: 8px 0;
    margin-top: 12px;
    white-space: nowrap;   /* ← 关键：强制"开始练习"四个字一行 */
    line-height: 1.2;
  }
}
