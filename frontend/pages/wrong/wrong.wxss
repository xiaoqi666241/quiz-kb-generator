.page {
  padding: 24rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: bold;
  margin: 20rpx 8rpx;
}

.wrong-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  border: 2rpx solid #fca5a5;
}

.wrong-stem {
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.5;
}

.wrong-meta {
  font-size: 24rpx;
  color: #888888;
  margin-top: 12rpx;
}

.wrong-answer {
  font-size: 26rpx;
  color: #16a34a;
  margin-top: 8rpx;
}

.retry-btn {
  background: #1f6feb;
  color: #ffffff;
  border-radius: 12rpx;
  font-size: 28rpx;
  margin-top: 20rpx;
}

.empty {
  text-align: center;
  color: #999999;
  font-size: 28rpx;
  margin-top: 120rpx;
}