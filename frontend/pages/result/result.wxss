.page {
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.result-box {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 60rpx 40rpx;
  margin-top: 120rpx;
  text-align: center;
  border: 2rpx solid #e5e7eb;
  width: 100%;
  box-sizing: border-box;
}

.result-title {
  font-size: 32rpx;
  color: #888888;
}

.score {
  font-size: 72rpx;
  font-weight: bold;
  color: #1f6feb;
  margin: 24rpx 0;
}

.rate {
  font-size: 30rpx;
  color: #444444;
}

.home-btn {
  background: #1f6feb;
  color: #ffffff;
  border-radius: 14rpx;
  font-size: 32rpx;
  width: 100%;
  margin-top: 40rpx;
}
