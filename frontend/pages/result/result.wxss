.page {
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.result-box {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 60rpx 40rpx;
  margin-top: 120rpx;
  text-align: center;
  border: 2rpx solid #e5e7eb;
  width: 100%;
  box-sizing: border-box;
}

.result-title {
  font-size: 32rpx;
  color: #888888;
}

.score {
  font-size: 72rpx;
  font-weight: bold;
  color: #1f6feb;
  margin: 24rpx 0;
}

.rate {
  font-size: 30rpx;
  color: #444444;
}

/* 返回首页：字号放大、框加高，宽度只包住文字（不撑满整行） */
.page .home-btn {
  background: #1f6feb;
  color: #ffffff;
  border-radius: 20rpx;
  font-size: 38rpx;
  line-height: 1.5;
  width: auto !important;
  box-sizing: border-box;
  padding: 22rpx 60rpx;
  white-space: nowrap;
  display: inline-block;
  margin: 48rpx auto 0;
}

/* ===== PC 宽屏适配（避免 rpx 放大导致按钮文字被裁切） ===== */
@media (min-width: 800px) {
  .page { padding: 16px; }
  .result-box { padding: 30px 20px; margin-top: 60px; border-radius: 10px; }
  .result-title { font-size: 16px; }
  .score { font-size: 36px; margin: 12px 0; }
  .rate { font-size: 15px; }
  .page .home-btn { font-size: 19px; line-height: 1.5; padding: 11px 30px; margin-top: 24px; border-radius: 10px; width: auto !important; }
}
