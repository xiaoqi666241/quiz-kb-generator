.page {
  padding: 32rpx;
}

.cloud-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1f2937;
}

.cloud-tip {
  font-size: 26rpx;
  color: #6b7280;
  line-height: 1.7;
  margin: 16rpx 0 32rpx;
}

.cloud-warn {
  background: #fff7e6;
  border: 2rpx solid #f5c26b;
  color: #b45309;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 26rpx;
  line-height: 1.6;
  margin-bottom: 28rpx;
}

.cloud-btn {
  width: 100%;
  border-radius: 14rpx;
  font-size: 32rpx;
  white-space: nowrap;
  line-height: 1.4;
  margin-bottom: 20rpx;
}

.backup-btn {
  background: #1f6feb;
  color: #ffffff;
}

.restore-btn {
  background: #ffffff;
  color: #1f6feb;
  border: 2rpx solid #1f6feb;
}

.cloud-btn[disabled] {
  background: #e5e7eb;
  color: #9ca3af;
  border-color: #e5e7eb;
}

.cloud-last {
  font-size: 24rpx;
  color: #9ca3af;
  text-align: center;
  margin-top: 12rpx;
}

/* ===== PC 宽屏适配 ===== */
@media (min-width: 800px) {
  .page { padding: 16px; }
  .cloud-title { font-size: 20px; }
  .cloud-tip { font-size: 13px; margin: 8px 0 16px; }
  .cloud-warn { font-size: 13px; padding: 10px; margin-bottom: 14px; }
  .cloud-btn { font-size: 16px; padding: 8px 0; margin-bottom: 10px; }
  .cloud-last { font-size: 12px; }
}
