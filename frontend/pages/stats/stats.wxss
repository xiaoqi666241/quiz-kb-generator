.page {
  padding: 30rpx;
  background: #f6f7f9;
  min-height: 100vh;
  box-sizing: border-box;
}
.empty {
  text-align: center;
  padding-top: 200rpx;
  color: #999;
  font-size: 28rpx;
}
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
}
.overview {
  display: flex;
  justify-content: space-between;
}
.ov-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.ov-num {
  font-size: 44rpx;
  font-weight: bold;
  color: #2b6de8;
}
.ov-label {
  font-size: 24rpx;
  color: #888;
  margin-top: 8rpx;
}
.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin: 20rpx 0 12rpx;
}
.point-row {
  margin-bottom: 24rpx;
}
.point-head {
  display: flex;
  justify-content: space-between;
  margin-bottom: 10rpx;
}
.point-name {
  font-size: 28rpx;
  color: #333;
}
.point-acc {
  font-size: 24rpx;
  color: #888;
}
.bar-wrap {
  height: 16rpx;
  background: #eef0f3;
  border-radius: 8rpx;
  overflow: hidden;
}
.bar {
  height: 100%;
  background: linear-gradient(90deg, #5b9cff, #2b6de8);
  border-radius: 8rpx;
}
.record-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  font-size: 26rpx;
}
.record-time { color: #666; }
.record-acc { color: #2b6de8; }
